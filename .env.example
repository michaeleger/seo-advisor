# Copy to .env and fill in real values:
#   cp .env.example .env && chmod 600 .env
# Never commit .env. Each key should appear ONCE — python-dotenv silently
# lets the last duplicate win.
#
# Unset keys fall back to the defaults in config.py; the values shown here
# ARE those defaults. Relative file paths resolve against the project
# directory (where config.py lives), not the current working directory.

# ─── Google Search Console ───────────────────────────────────────────────────
GSC_SITE_URL=sc-domain:eagertobehealthy.com
GSC_CREDENTIALS_FILE=client_secret.json
# OAuth tokens live in token.json (gitignored, mode 0600) after: python authorize.py

# ─── WordPress ───────────────────────────────────────────────────────────────
WP_SITE_URL=https://www.eagertobehealthy.com
# Optional — real RankMath plugin scores via /rankmath/v1/links/posts
# WP_APP_USER=
# WP_APP_PASSWORD=
#
# Catalog budgets, PER CONTENT TYPE (posts and pages paged separately, so
# posts can never starve pages). Truncation is logged.
# WP_CATALOG_PER_TYPE_MAX=2000
# Rank Math score rows pulled for the score overlay (its own budget).
# WP_RANKMATH_MAX_ITEMS=2000

# ─── Search Console window & demand ──────────────────────────────────────────
# Main GSC window. Missed-clicks figures are sized over this window and
# labelled to match (clicks/yr at 365, clicks/<N>d otherwise).
DATE_RANGE_DAYS=365
# Demand floor: pages under this many impressions are undiscovered, not
# under-performing, and are not ranked.
MIN_IMPRESSIONS=10
MAX_POSTS_TO_ANALYZE=10
# Include pages with no Search Console traffic at all (off by default).
# INCLUDE_ZERO_TRAFFIC_PAGES=0
# Position treated as "captured" when sizing ranking upside.
# TARGET_POSITION=5

# ─── Ranking — "most neglected under-performing page" ────────────────────────
# priority = missed clicks × neglect × fixability × decay
# Neglect rises from 1.0 (edited today) to NEGLECT_MAX_MULTIPLIER once a page
# has been untouched for NEGLECT_FULL_DAYS.
# NEGLECT_FULL_DAYS=730
# NEGLECT_MAX_MULTIPLIER=3.0
# Decay compares impressions over its OWN short adjacent window (kept inside
# GSC's ~16-month retention), not DATE_RANGE_DAYS.
# DECAY_WINDOW_DAYS=90
# Fixability comes from the Rank Math score (1.0–2.0; unknown = 1.3). Pages
# at or above this score are skipped.
RANKMATH_SKIP_SCORE=80

# ─── Backoff — deferred pages always return ──────────────────────────────────
# Each unedited suggestion pushes the page's eligibility out by the next step;
# the last value is a cap, so a page is never silently dropped.
# BACKOFF_DAYS=30,60,90,180
# After a detected edit, hold the page this long so Google can reprocess it.
# EDIT_COOLDOWN_DAYS=90

# ─── Legacy knobs (parsed, not used by neglect ranking) ──────────────────────
# MAX_CTR / MAX_POSITION only feed the legacy low-performer reasons and the
# GSC opportunity lists; COOLDOWN_DAYS only backs --no-cooldown help text;
# PRIORITIZE_BY_RANKMATH is no longer read. Phase D removes them.
# MAX_CTR=0.05
# MAX_POSITION=20
# COOLDOWN_DAYS=60
# PRIORITIZE_BY_RANKMATH=1

# ─── Output ──────────────────────────────────────────────────────────────────
# REPORTS_DIR=reports
# Save each selected page's WordPress HTML to reports/pages_YYYY-MM-DD/.
# SAVE_PAGE_SNAPSHOTS=1

# ─── Page filtering — URLs never worth optimizing ────────────────────────────
# Defaults below are generic. Unset = use the default; set = REPLACE it,
# except SKIP_SLUGS_EXTRA which ADDS to SKIP_SLUGS. All comma-separated.
#
# Structural WordPress paths (substring match on the URL path):
# SKIP_PATH_SEGMENTS=/category/,/tag/,/author/,/page/,/wp-json/,/wp-admin/,/feed/
#
# Exact slugs that are never article content:
# SKIP_SLUGS=,home,about,contact,privacy-policy,cookie-policy,terms,terms-of-service
#
# Your site's own junk slugs — ADDS to SKIP_SLUGS, so you need not restate it:
# SKIP_SLUGS_EXTRA=team-page,internal-notes
#
# Substrings marking a slug as non-content wherever they appear:
# SKIP_SLUG_SUBSTRINGS=privacy-policy,cookie,terms-of
#
# Note: there is no minimum-slug-length filter. Short slugs like /abs/ or
# /gut/ are legitimate articles; list them above if yours are not.

# ─── Google Ads Keyword Planner (optional; gated) ────────────────────────────
# Needs a developer token with Basic access — Test tokens cannot query real
# accounts. Do not rely on this in production until Basic access is proven.
# USE_KEYWORD_PLANNER=1
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_GEO_TARGET_IDS=2840

# ─── Bing Webmaster (optional, free) ─────────────────────────────────────────
# USE_BING=1
# BING_API_KEY=
# BING_SITE_URL=https://www.eagertobehealthy.com/

# ─── PageSpeed Insights (free; scans ONLY selected pages) ────────────────────
# Google Cloud → enable "PageSpeed Insights API" → create API key
# PAGESPEED_API_KEY is REQUIRED: without it the stage is skipped, because
# anonymous PSI quota returns HTTP 429 for every URL. The stage also stops
# after the first 429 rather than spending a request per remaining page.
USE_PAGESPEED=1
# PAGESPEED_API_KEY=
# PAGESPEED_STRATEGIES=mobile
# PAGESPEED_STRATEGIES=mobile,desktop
# PAGESPEED_TIMEOUT_SECONDS=120
# PAGESPEED_PAUSE_SECONDS=1.5

# ─── Optional local LLM ──────────────────────────────────────────────────────
USE_LOCAL_LLM=0
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_THREAD=6
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=ollama
# LLM_MAX_TOKENS=2048
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=600
