# ─── Google Search Console ────────────────────────────────────────────────────
# Path to your service account JSON key file
GSC_CREDENTIALS_FILE=client_secret.json
# Exact site URL as it appears in Search Console (include trailing slash if needed)
GSC_SITE_URL=https://eagertobehealthy.com/

# ─── WordPress ────────────────────────────────────────────────────────────────
WP_SITE_URL=https://eagertobehealthy.com

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Analysis settings ───────────────────────────────────────────────────────
# How many days of GSC data to pull
DATE_RANGE_DAYS=90
# Minimum impressions for a post to be considered (filters out brand-new posts)
MIN_IMPRESSIONS=50
# Posts with CTR below this are flagged (0.05 = 5%)
MAX_CTR=0.05
# Posts with average position worse than this are flagged
MAX_POSITION=20
# Max posts to run through Claude per weekly run (controls API cost)
MAX_POSTS_TO_ANALYZE=10

# ─── Scheduling & cooldown ───────────────────────────────────────────────────
# Days before a page can appear in a report again (default: 60)
COOLDOWN_DAYS=60
# Directory where HTML reports are saved (served by nginx on port 8080)
REPORTS_DIR=reports
