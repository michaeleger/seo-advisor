# Copy to .env and fill in real values:
#   cp .env.example .env
# Never commit .env

# ─── Google Search Console ───────────────────────────────────────────────────
GSC_SITE_URL=sc-domain:eagertobehealthy.com
GSC_CREDENTIALS_FILE=client_secret.json
# OAuth tokens live in token.json (gitignored) after: python authorize.py

# ─── WordPress ───────────────────────────────────────────────────────────────
WP_SITE_URL=https://www.eagertobehealthy.com
# Optional — real RankMath plugin scores via /rankmath/v1/links/posts
# WP_APP_USER=
# WP_APP_PASSWORD=

# ─── Report tuning ───────────────────────────────────────────────────────────
DATE_RANGE_DAYS=365
MIN_IMPRESSIONS=1
MAX_CTR=0.05
MAX_POSITION=20
MAX_POSTS_TO_ANALYZE=10
COOLDOWN_DAYS=60
PRIORITIZE_BY_RANKMATH=1
RANKMATH_SKIP_SCORE=80

# ─── Page filtering — URLs never worth optimizing ────────────────────────────
# Defaults below are generic. Unset = use the default; set = REPLACE it,
# except SKIP_SLUGS_EXTRA which ADDS to SKIP_SLUGS. All comma-separated.
#
# Structural WordPress paths (substring match on the URL path):
# SKIP_PATH_SEGMENTS=/category/,/tag/,/author/,/page/,/wp-json/,/wp-admin/,/feed/
#
# Exact slugs that are never article content:
# SKIP_SLUGS=,home,about,contact,privacy-policy,cookie-policy,terms,terms-of-service
#
# Your site's own junk slugs — ADDS to SKIP_SLUGS, so you need not restate it:
# SKIP_SLUGS_EXTRA=team-page,internal-notes
#
# Substrings marking a slug as non-content wherever they appear:
# SKIP_SLUG_SUBSTRINGS=privacy-policy,cookie,terms-of
#
# Note: there is no minimum-slug-length filter. Short slugs like /abs/ or
# /gut/ are legitimate articles; list them above if yours are not.

# ─── Google Ads Keyword Planner (optional) ───────────────────────────────────
# USE_KEYWORD_PLANNER=1
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_GEO_TARGET_IDS=2840

# ─── Bing Webmaster (optional, free) ─────────────────────────────────────────
# USE_BING=1
# BING_API_KEY=
# BING_SITE_URL=https://www.eagertobehealthy.com/

# ─── PageSpeed Insights (free; scans ONLY selected worst-N pages) ─────────────
# Google Cloud → enable "PageSpeed Insights API" → create API key
USE_PAGESPEED=1
# PAGESPEED_API_KEY=
# PAGESPEED_STRATEGIES=mobile
# PAGESPEED_STRATEGIES=mobile,desktop


# ─── Optional local LLM ──────────────────────────────────────────────────────
USE_LOCAL_LLM=0
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
